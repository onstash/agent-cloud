{
  "name": "agent-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "format": "oxfmt src scripts test",
    "format:check": "oxfmt --check src scripts test",
    "lint": "oxlint src scripts test",
    "test": "node --test test/local-broker.test.mjs test/patch.test.mjs test/prepare.integration.test.mjs test/snapshot.test.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@oxlint/plugins": "^1.87.0",
    "@types/node": "^24.0.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@10.10.0",
  "version": "1.0.0"
}
